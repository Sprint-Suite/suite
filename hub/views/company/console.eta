<%~ include("../partials/header", { title: "Manage · " + it.company.name, user: it.user }) %>
<nav class="subnav"><a class="lnk" href="/dashboard">← Dashboard</a></nav>
<h1><%= it.company.name %></h1>
<% if (it.notice) { %><div class="notice<%= it.notice.ok ? '' : ' notice-err' %>" role="status"><%= it.notice.text %></div><% } %>
<div class="card">
<h2>Members (<%= it.members.length %>)</h2>
<form method="POST" action="/company/<%= it.company.slug %>/members" class="formrow is-spaced">
<div class="field grows"><label class="label">Invite by email</label><input class="input" type="email" name="email" placeholder="email@example.com" required></div>
<select class="input is-auto" name="role">
<option value="member">Member</option>
<option value="owner">Owner</option>
</select>
<button class="btn btn-pri" type="submit">Invite and email link</button>
</form>
<div class="table-wrap"><table class="table">
<thead><tr><th>Email</th><th>Role</th><th>Teams</th><th>Sign-in</th><th></th></tr></thead>
<tbody>
<% const base = "/company/" + it.company.slug + "/members/"; %>
<% for (const m of it.members) { %>
<tr>
<td><%= m.email %></td>
<td>
<div class="tbacts">
<span class="pill pill-ok"><%= m.role === "owner" ? "Owner" : "Member" %></span>
<% if (m.role === "owner") { %>
<form method="POST" action="<%= base + m.userId %>/role"><input type="hidden" name="role" value="member"><button class="btn btn-ghost btn-sm" type="submit">Make member</button></form>
<% } else { %>
<form method="POST" action="<%= base + m.userId %>/role" data-confirm="Make <%= m.email %> an owner? Owners can manage <%= it.company.name %>." data-confirm-title="Make owner" data-confirm-ok="Make owner"><input type="hidden" name="role" value="owner"><button class="btn btn-ghost btn-sm" type="submit">Make owner</button></form>
<% } %>
</div>
</td>
<td><span class="micro"><%= m.teams.length ? m.teams.join(", ") : "—" %></span></td>
<td>
<div class="tbacts">
<span class="pill <%= m.hasLoggedIn ? 'pill-ok' : 'pill-closed' %>"><%= m.hasLoggedIn ? "Signed in" : "Never signed in" %></span>
<% if (!m.hasLoggedIn) { %>
<form method="POST" action="<%= base + m.userId %>/resend"><button class="btn btn-ghost btn-sm" type="submit">Resend link</button></form>
<% } %>
</div>
</td>
<td>
<form method="POST" action="<%= base + m.userId %>/remove" data-confirm="Remove this member from <%= it.company.name %>?" data-confirm-title="Remove member" data-confirm-ok="Remove"><button class="btn btn-danger btn-sm">Remove</button></form>
</td>
</tr>
<% } %>
</tbody></table></div>
</div>
<div class="card">
<h2>Teams (<%= it.teams.length %>)</h2>
<form method="POST" action="/company/<%= it.company.slug %>/teams" class="formrow is-spaced">
<div class="field grows-capped"><label class="label">New team</label><input class="input" type="text" name="name" placeholder="Team name" required></div>
<button class="btn btn-pri" type="submit">Create team</button>
</form>
<p class="micro">Add or remove people from a team on the team's own page.</p>
<ul class="plain">
<% for (const t of it.teams) { %>
<li><a class="lnk" href="/company/<%= it.company.slug %>/teams/<%= t.id %>"><%= t.name %></a></li>
<% } %>
</ul>
</div>
<%~ include("../partials/footer") %>
